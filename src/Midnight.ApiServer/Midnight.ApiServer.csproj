<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Midnight.ApiServer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <UserSecretsId>midnight-panel-apiserver</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Midnight.Shared\Midnight.Shared.csproj" />
    <ProjectReference Include="..\Midnight.Plugins.Abstractions\Midnight.Plugins.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Midnight.Panel.Tests" />
  </ItemGroup>

  <!--
    Web frontend (src/Midnight.Web, React + Mantine). Vite writes the build into wwwroot.
    Runs automatically when the frontend changed; set SkipWebBuild=true to build the api without node.
  -->
  <PropertyGroup>
    <WebRoot>..\Midnight.Web\</WebRoot>
  </PropertyGroup>

  <!--
    wwwroot is generated by Vite with hashed file names. It is served with UseStaticFiles and copied on publish,
    not tracked as static web assets (their manifest would point to file names of the previous build).
  -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <None Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <WebSources Include="$(WebRoot)src\**;$(WebRoot)public\**;$(WebRoot)index.html;$(WebRoot)package.json;$(WebRoot)vite.config.ts" />
  </ItemGroup>

  <Target Name="WebInstall" BeforeTargets="WebBuild" Condition="'$(SkipWebBuild)' != 'true' And !Exists('$(WebRoot)node_modules')">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(WebRoot)" />
  </Target>

  <Target Name="WebBuild" BeforeTargets="BeforeBuild" Condition="'$(SkipWebBuild)' != 'true'" Inputs="@(WebSources)" Outputs="wwwroot\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(WebRoot)" />
  </Target>

</Project>
